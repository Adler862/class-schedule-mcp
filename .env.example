# 复制为 .env 或直接设为环境变量；全部可选
SCHEDULE_CITY=北京
SCHEDULE_CITY_CODE=101010100
SCHEDULE_COURSES=./config/courses.json
SCHEDULE_PREFS=./config/news_prefs.json
# 微信图片直推所需（从 Cherry Studio 的通道目录读取，通常无需手动设置）
# ILINK_CHANNEL_DIR=~/AppData/Roaming/CherryStudio/Data/Channels
# 自定义字体（可选）
# SCHEDULE_FONT=C:/Windows/Fonts/msyh.ttc
# SCHEDULE_FONT_BOLD=C:/Windows/Fonts/msyhbd.ttc
# 渲染时去掉哪些地点前缀（各校命名不同，逗号分隔；默认不去）
# SCHEDULE_LOCATION_STRIP=主校区,分校区
